/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; img-src 'self' https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self'; font-src 'self'; connect-src https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; script-src 'self' https://www.googletagmanager.com; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=86400

/styles.css
  Cache-Control: no-cache, must-revalidate
