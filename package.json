{
  "name": "gemini-exporter",
  "version": "1.6.3",
  "description": "100% Free & open-source • Real-time auto-save • One-click batch export to Markdown • Reclaim full Gemini history via Takeout",
  "main": "background.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "node build.js",
    "package": "node build.js --pack",
    "test:unit": "python3 tests/run_tests.py",
    "test:e2e": "node build.js && playwright test",
    "test": "npm run type-check && python3 tests/run_tests.py && node build.js && playwright test",
    "test:changed": "python3 scripts/run_changed_tests.py",
    "test:impact": "python3 scripts/test_impact_analyzer.py --summary",
    "test:manual": "./scripts/open_test_chrome.sh",
    "test:manual:win": "powershell -ExecutionPolicy Bypass -File ./scripts/open_test_chrome.ps1",
    "test:generate-chats": "python3 scripts/generate_scenario_chats.py",
    "test:live": "python3 scripts/test_live_chat_and_export.py",
    "test:live:pool": "python3 scripts/test_live_chat_and_export.py --pool",
    "test:live:local": "python3 scripts/test_live_chat_and_export.py",
    "pool:status": "python3 scripts/manage_scenario_pool.py status",
    "pool:validate": "python3 scripts/manage_scenario_pool.py validate",
    "test:visual": "python3 scripts/test_visual_agent.py --playground",
    "test:visual:custom": "python3 scripts/test_visual_agent.py --api",
    "release": "gh workflow run release.yml --ref main",
    "lint": "oxlint -A all -D typescript/no-floating-promises --type-aware src/"
  },
  "keywords": [
    "gemini",
    "google-gemini",
    "exporter",
    "markdown",
    "chrome-extension",
    "open-source"
  ],
  "author": "Wenbo Cui",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  }
}
